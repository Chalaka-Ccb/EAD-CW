<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RestockProfitReport" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762" leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30" whenNoDataType="AllSectionsNoDetail">
<parameter name="FROM_DATE" class="java.sql.Date"/>
<parameter name="TO_DATE" class="java.sql.Date"/>
<queryString><![CDATA[SELECT p.part_no AS part_no, p.name AS part_name, c.name AS category, COALESCE(SUM(CASE WHEN s.invoice_date BETWEEN $P{FROM_DATE} AND $P{TO_DATE} THEN i.quantity ELSE 0 END),0) AS sold_qty, COALESCE(SUM(CASE WHEN s.invoice_date BETWEEN $P{FROM_DATE} AND $P{TO_DATE} THEN i.line_total ELSE 0 END),0) AS revenue, COALESCE(SUM(CASE WHEN s.invoice_date BETWEEN $P{FROM_DATE} AND $P{TO_DATE} THEN i.line_total - i.quantity * p.cost_price ELSE 0 END),0) AS gross_profit, p.stock_qty AS stock_qty, CASE WHEN p.stock_qty <= p.reorder_level THEN 'REORDER' ELSE 'OK' END AS stock_status FROM parts p JOIN categories c ON c.category_id = p.category_id LEFT JOIN invoice_items i ON i.part_id = p.part_id LEFT JOIN sales_invoices s ON s.invoice_id = i.invoice_id GROUP BY p.part_id, p.part_no, p.name, c.name, p.stock_qty, p.reorder_level ORDER BY (p.stock_qty <= p.reorder_level) DESC, gross_profit DESC]]></queryString>
<field name="part_no" class="java.lang.String"/>
<field name="part_name" class="java.lang.String"/>
<field name="category" class="java.lang.String"/>
<field name="sold_qty" class="java.math.BigDecimal"/>
<field name="revenue" class="java.math.BigDecimal"/>
<field name="gross_profit" class="java.math.BigDecimal"/>
<field name="stock_qty" class="java.lang.Integer"/>
<field name="stock_status" class="java.lang.String"/>
<variable name="totalRevenue" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{revenue}]]></variableExpression></variable><variable name="totalProfit" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{gross_profit}]]></variableExpression></variable><title><band height="90"><staticText><reportElement x="0" y="2" width="750" height="26"/><textElement><font size="17" isBold="true"/></textElement><text><![CDATA[STARK INDUSTRY | Sales and Restock Decisions]]></text></staticText><staticText><reportElement x="0" y="35" width="750" height="20"/><text><![CDATA[Date-filtered sales, estimated gross profit and stock reorder priorities]]></text></staticText><textField><reportElement x="0" y="60" width="740" height="18"/><textFieldExpression><![CDATA["Reporting period: "+$P{FROM_DATE}+" to "+$P{TO_DATE}]]></textFieldExpression></textField></band></title>
<columnHeader><band height="24"><staticText><reportElement x="0" y="0" width="85" height="20" backcolor="#E6EEF7" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Part No]]></text></staticText><staticText><reportElement x="85" y="0" width="160" height="20" backcolor="#E6EEF7" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Part]]></text></staticText><staticText><reportElement x="245" y="0" width="115" height="20" backcolor="#E6EEF7" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Category]]></text></staticText><staticText><reportElement x="360" y="0" width="55" height="20" backcolor="#E6EEF7" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Sold]]></text></staticText><staticText><reportElement x="415" y="0" width="90" height="20" backcolor="#E6EEF7" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Revenue]]></text></staticText><staticText><reportElement x="505" y="0" width="100" height="20" backcolor="#E6EEF7" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Gross Profit]]></text></staticText><staticText><reportElement x="605" y="0" width="55" height="20" backcolor="#E6EEF7" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Stock]]></text></staticText><staticText><reportElement x="660" y="0" width="102" height="20" backcolor="#E6EEF7" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Action]]></text></staticText></band></columnHeader>
<detail><band height="24"><textField><reportElement x="0" y="2" width="85" height="18"/><textFieldExpression><![CDATA[$F{part_no}]]></textFieldExpression></textField><textField><reportElement x="85" y="2" width="160" height="18"/><textFieldExpression><![CDATA[$F{part_name}]]></textFieldExpression></textField><textField><reportElement x="245" y="2" width="115" height="18"/><textFieldExpression><![CDATA[$F{category}]]></textFieldExpression></textField><textField><reportElement x="360" y="2" width="55" height="18"/><textFieldExpression><![CDATA[$F{sold_qty}]]></textFieldExpression></textField><textField pattern="#,##0.00"><reportElement x="415" y="2" width="90" height="18"/><textFieldExpression><![CDATA[$F{revenue}]]></textFieldExpression></textField><textField pattern="#,##0.00"><reportElement x="505" y="2" width="100" height="18"/><textFieldExpression><![CDATA[$F{gross_profit}]]></textFieldExpression></textField><textField><reportElement x="605" y="2" width="55" height="18"/><textFieldExpression><![CDATA[$F{stock_qty}]]></textFieldExpression></textField><textField><reportElement x="660" y="2" width="102" height="18"/><textFieldExpression><![CDATA[$F{stock_status}]]></textFieldExpression></textField></band></detail>
<pageFooter><band height="22"><textField><reportElement x="650" y="0" width="110" height="20"/><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter><summary><band height="62"><staticText><reportElement x="0" y="0" width="260" height="20"/><textElement><font size="12" isBold="true"/></textElement><text><![CDATA[Period totals (Rs.)]]></text></staticText><textField pattern="#,##0.00"><reportElement x="270" y="0" width="220" height="20"/><textFieldExpression><![CDATA["Revenue: "+new java.text.DecimalFormat("#,##0.00").format($V{totalRevenue})]]></textFieldExpression></textField><textField><reportElement x="500" y="0" width="260" height="20"/><textFieldExpression><![CDATA["Estimated gross profit: "+new java.text.DecimalFormat("#,##0.00").format($V{totalProfit})]]></textFieldExpression></textField><staticText><reportElement x="0" y="30" width="750" height="18"/><text><![CDATA[Gross profit uses current purchase costs; excludes operating expenses and invoice discounts.]]></text></staticText></band></summary>
</jasperReport>