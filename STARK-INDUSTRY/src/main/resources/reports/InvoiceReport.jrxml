<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="InvoiceReport" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762" leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30" whenNoDataType="AllSectionsNoDetail">
<parameter name="INVOICE_ID" class="java.lang.Integer"/>
<queryString><![CDATA[SELECT s.invoice_id AS invoice_id, s.invoice_date AS invoice_date, c.name AS customer_name, p.name AS part_name, i.quantity AS quantity, i.unit_price AS unit_price, i.line_total AS line_total, s.total_amount AS invoice_total, s.payment_method AS payment_method FROM sales_invoices s JOIN customers c ON c.customer_id=s.customer_id JOIN invoice_items i ON i.invoice_id=s.invoice_id JOIN parts p ON p.part_id=i.part_id WHERE s.invoice_id=$P{INVOICE_ID} ORDER BY i.item_id]]></queryString>
<field name="invoice_id" class="java.lang.Integer"/>
<field name="invoice_date" class="java.sql.Date"/>
<field name="customer_name" class="java.lang.String"/>
<field name="part_name" class="java.lang.String"/>
<field name="quantity" class="java.lang.Integer"/>
<field name="unit_price" class="java.math.BigDecimal"/>
<field name="line_total" class="java.math.BigDecimal"/>
<field name="invoice_total" class="java.math.BigDecimal"/>
<field name="payment_method" class="java.lang.String"/>
<title><band height="64"><staticText><reportElement x="0" y="2" width="750" height="26"/><textElement><font size="17" isBold="true"/></textElement><text><![CDATA[STARK INDUSTRY | Customer Invoice]]></text></staticText><staticText><reportElement x="0" y="35" width="750" height="20"/><text><![CDATA[Printable sales invoice with customer, item and payment details]]></text></staticText></band></title>
<columnHeader><band height="24"><staticText><reportElement x="0" y="0" width="65" height="20" backcolor="#E6EEF7" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Invoice]]></text></staticText><staticText><reportElement x="65" y="0" width="85" height="20" backcolor="#E6EEF7" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Date]]></text></staticText><staticText><reportElement x="150" y="0" width="135" height="20" backcolor="#E6EEF7" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Customer]]></text></staticText><staticText><reportElement x="285" y="0" width="170" height="20" backcolor="#E6EEF7" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Item]]></text></staticText><staticText><reportElement x="455" y="0" width="45" height="20" backcolor="#E6EEF7" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Qty]]></text></staticText><staticText><reportElement x="500" y="0" width="85" height="20" backcolor="#E6EEF7" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Unit Price]]></text></staticText><staticText><reportElement x="585" y="0" width="90" height="20" backcolor="#E6EEF7" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Line Total]]></text></staticText><staticText><reportElement x="675" y="0" width="87" height="20" backcolor="#E6EEF7" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Invoice Total]]></text></staticText></band></columnHeader>
<detail><band height="24"><textField><reportElement x="0" y="2" width="65" height="18"/><textFieldExpression><![CDATA[$F{invoice_id}]]></textFieldExpression></textField><textField><reportElement x="65" y="2" width="85" height="18"/><textFieldExpression><![CDATA[$F{invoice_date}]]></textFieldExpression></textField><textField><reportElement x="150" y="2" width="135" height="18"/><textFieldExpression><![CDATA[$F{customer_name}]]></textFieldExpression></textField><textField><reportElement x="285" y="2" width="170" height="18"/><textFieldExpression><![CDATA[$F{part_name}]]></textFieldExpression></textField><textField><reportElement x="455" y="2" width="45" height="18"/><textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression></textField><textField pattern="#,##0.00"><reportElement x="500" y="2" width="85" height="18"/><textFieldExpression><![CDATA[$F{unit_price}]]></textFieldExpression></textField><textField pattern="#,##0.00"><reportElement x="585" y="2" width="90" height="18"/><textFieldExpression><![CDATA[$F{line_total}]]></textFieldExpression></textField><textField pattern="#,##0.00"><reportElement x="675" y="2" width="87" height="18"/><textFieldExpression><![CDATA[$F{invoice_total}]]></textFieldExpression></textField></band></detail>
<pageFooter><band height="22"><textField><reportElement x="650" y="0" width="110" height="20"/><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter>
</jasperReport>